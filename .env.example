# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in YOUR OWN values. `.env` is gitignored, so
# your keys never get committed. Every key below is OPTIONAL: with none set, the
# app still runs on the baked product catalog with email+password accounts.
# Do NOT use anyone else's keys — each deployment must supply its own.
# (docker-compose loads `.env` automatically.)
# -----------------------------------------------------------------------------

# Session cookie signing. Leave blank to auto-generate one to data/.session-secret.
SESSION_SECRET=

# Public origin of YOUR deployment. Used for share links, the Google OAuth
# redirect URL, and magic-link URLs. For local dev use http://localhost:3101
APP_ORIGIN=http://localhost:3101

# --- Google sign-in (optional) ---------------------------------------------
# Create your own OAuth 2.0 "Web application" client at
# https://console.cloud.google.com -> APIs & Services -> Credentials.
# Authorized redirect URI must be  <APP_ORIGIN>/api/auth/google/callback
# Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Magic-link email sign-in (optional) -----------------------------------
# Your own SMTP credentials (e.g. a Gmail App Password). Leave SMTP_HOST blank
# to hide the "email me a link" option.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Live niche product lookup (optional) ----------------------------------
# Your own SerpApi key (free tier = 250 searches/month) from
# https://serpapi.com/manage-api-key . Powers live, accurately-photographed,
# priced gift results for niche interests the catalog does not cover. Results
# are cached (data/serpapi-cache.json) so repeat niches do not spend searches.
# Leave blank to fall back to the catalog only.
SERPAPI_KEY=

# NOTE: the AI "Generate / Steer / Refine" features read their own keys from a
# separate `.llm-env` file (Groq + Gemini). See `.llm-env.example`.
